# Copier en .env (chmod 600) et remplir. Ne jamais commiter le fichier .env.

# Base MariaDB (Infomaniak) : mysql://utilisateur:motdepasse@hote:3306/base
NUXT_DATABASE_URL=

# Secret de chiffrement des cookies de session : 32 caractères minimum, aléatoire
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NUXT_SESSION_PASSWORD=

# Secret de la route /api/cron/daily : 24 caractères minimum, aléatoire
NUXT_CRON_SECRET=

# Dossier persistant pour les PDF archivés et les contrats (hors du dossier de l'application)
NUXT_STORAGE_DIR=../mportal-storage

# Applique les migrations SQL au démarrage (true par défaut)
NUXT_MIGRATE_ON_START=true

# Planificateur intégré (génération des factures d'abonnement toutes les heures)
NUXT_SCHEDULER_ENABLED=true

# Fourni par Infomaniak ; défaut 3000
# PORT=3000

# --- Uniquement pour la migration depuis l'ancienne application ---
# LEGACY_DATABASE_URL=mysql://utilisateur:motdepasse@hote:3306/ancienne_base
